#!/usr/bin/env bash
# ═══════════════════════════════════════════════════════════
#  PDF Tool Pro — Linux GUI Launcher
#  Double-click this file to open the PDF Tool Pro web UI
#  directly in your browser — no terminal needed.
#
#  It will check that Python and required packages are
#  installed before launching.
# ═══════════════════════════════════════════════════════════

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"

LOG_FILE="/tmp/pdf-tool-pro-launch.log"
PID_FILE="/tmp/pdf-tool-pro.pid"

PORT=8501

# ── Helper: get Streamlit PID from PID file ──
get_pid_from_file() {
    if [ -f "$PID_FILE" ]; then
        local pid
        pid=$(cat "$PID_FILE" 2>/dev/null)
        if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
            echo "$pid"
        else
            # Stale PID file — process is gone
            rm -f "$PID_FILE"
        fi
    fi
}

# ── Helper: get PID from ss/lsof/fuser/pgrep (may fail due to permissions) ──
get_pid_from_system() {
    local pid=""
    # Try lsof first (most reliable when available)
    if [ -z "$pid" ] && command -v lsof &>/dev/null; then
        pid=$(lsof -ti :"$PORT" -sTCP:LISTEN 2>/dev/null | head -1)
    fi
    # Try fuser
    if [ -z "$pid" ] && command -v fuser &>/dev/null; then
        pid=$(fuser "$PORT/tcp" 2>/dev/null | tr -s ' ' | head -1 | tr -d ' ')
    fi
    # Try ss (may fail due to permissions — Process column can be empty)
    if [ -z "$pid" ] && command -v ss &>/dev/null; then
        pid=$(ss -tlnp "sport = :$PORT" 2>/dev/null | grep -oP 'pid=\K[0-9]+' | head -1)
    fi
    # Try pgrep as last resort — reads /proc, no socket permissions needed
    if [ -z "$pid" ] && command -v pgrep &>/dev/null; then
        pid=$(pgrep -f 'streamlit.*pdf_ui' 2>/dev/null | head -1)
    fi
    if [ -n "$pid" ]; then
        echo "$pid"
        return 0
    fi
    return 1
}

# ── Helper: check if port is in use ──
port_in_use() {
    ss -tln 2>/dev/null | grep -qE ":${PORT}[[:space:]]"
}

# ── Helper: kill process by port (no PID needed) ──
kill_by_port() {
    if command -v fuser &>/dev/null; then
        fuser -k "$PORT/tcp" 2>/dev/null
        sleep 1
        if port_in_use; then
            return 1
        fi
        return 0
    fi
    return 1
}

# ── Handle --stop flag ──
if [ "$1" = "--stop" ] || [ "$1" = "-s" ]; then
    PID=""
    # Try PID file first (most reliable)
    PID=$(get_pid_from_file 2>/dev/null)
    # Fall back to system methods
    if [ -z "$PID" ]; then
        PID=$(get_pid_from_system 2>/dev/null)
    fi
    if [ -n "$PID" ]; then
        echo "Stopping Streamlit (PID: $PID)..."
        kill "$PID" 2>/dev/null
        sleep 1
        # Force kill if still running
        if kill -0 "$PID" 2>/dev/null; then
            kill -9 "$PID" 2>/dev/null
        fi
        rm -f "$PID_FILE"
        echo "✅ Streamlit stopped."
        notify-send "PDF Tool Pro" "App stopped." -i dialog-information 2>/dev/null || true
    else
        # No PID found — try fuser -k to kill by port (no PID needed!)
        echo "⚠️  Could not find Streamlit PID — killing by port with fuser"
        if kill_by_port; then
            echo "✅ Streamlit stopped."
        else
            echo "⚠️  Could not stop Streamlit. You may need to kill it manually: pkill -f 'streamlit.*pdf_ui'"
        fi
        rm -f "$PID_FILE"
    fi
    exit 0
fi

# ── Handle --help flag ──
if [ "$1" = "--help" ] || [ "$1" = "-h" ]; then
    echo "PDF Tool Pro Launcher"
    echo ""
    echo "Usage:"
    echo "  ./run           Start PDF Tool Pro (opens browser)"
    echo "  ./run --stop    Stop the running server"
    echo "  ./run --help    Show this help"
    echo ""
    echo "Operations (available in the web UI):"
    echo ""
    echo "  📦 Compress        Reduce file size (auto, lossless, smart, aggressive, raster)"
    echo "  🔗 Merge           Combine multiple PDFs into a single file"
    echo "  ✂️ Split           Extract pages into separate files (all or specific range)"
    echo "  🔄 Rotate          Rotate all pages (90°, 180°, or 270°)"
    echo "  📐 Crop            Remove margins from pages (configurable per edge)"
    echo "  📝 Extract Text    Pull all text content from a PDF"
    echo "  🖼️ Extract Images  Save all embedded images to a folder"
    echo "  📑 Select Pages    Extract specific pages (e.g. 1,3,5-8)"
    echo "  💧 Watermark       Add text overlay to every page"
    echo "  ℹ️ Info            View metadata, page count, file details"
    echo ""
    echo "Notes:"
    echo "  - Ctrl+C stops Streamlit and exits"
    echo "  - PID file: /tmp/pdf-tool-pro.pid"
    echo "  - Log file: /tmp/pdf-tool-pro-launch.log"
    echo "  - Output folder: ./output/"
    exit 0
fi

echo "[$(date)] Starting PDF Tool Pro..." > "$LOG_FILE"

# ── Cleanup function (shared) ──
cleanup() {
    echo ""
    if [ -n "$STREAMLIT_PID" ] && kill -0 "$STREAMLIT_PID" 2>/dev/null; then
        echo "Stopping Streamlit (PID: $STREAMLIT_PID)..."
        kill "$STREAMLIT_PID" 2>/dev/null
        wait "$STREAMLIT_PID" 2>/dev/null
    fi
    rm -f "$PID_FILE"
    echo "✅ Streamlit stopped."
    exit 0
}

# ── Helper: show a GUI error dialog ──
show_error() {
    local title="$1"
    local msg="$2"
    echo "[$(date)] ERROR: $title - $msg" >> "$LOG_FILE"
    zenity --error --title="$title" --text="$msg" --width=450 2>/dev/null || \
    notify-send "$title" "$msg" 2>/dev/null || \
    true  # silently fail if no GUI tools available
}

# ── Find Python ──
PYTHON=""
for cmd in python3 python; do
    if command -v "$cmd" &> /dev/null; then
        PYTHON="$cmd"
        break
    fi
done

if [ -z "$PYTHON" ]; then
    show_error "PDF Tool Pro" "Python not found!\n\nPDF Tool Pro requires Python 3.9 or newer.\nInstall from: https://www.python.org/downloads/"
    exit 1
fi
echo "[$(date)] Python: $($PYTHON --version 2>&1)" >> "$LOG_FILE"

# ── Check required packages ──
MISSING=""
for pkg_info in "fitz:PyMuPDF" "streamlit:streamlit"; do
    import_name="${pkg_info%%:*}"
    pip_name="${pkg_info##*:}"
    if ! "$PYTHON" -c "import $import_name" 2>/dev/null; then
        MISSING="$MISSING $pip_name"
        echo "[$(date)] MISSING: $pip_name" >> "$LOG_FILE"
    fi
done

if [ -n "$MISSING" ]; then
    show_error "PDF Tool Pro" "Missing Python packages!\n\nRun in a terminal:\n\npip install$MISSING\n\nOr: pip install -r requirements.txt"
    exit 1
fi
echo "[$(date)] All dependencies OK" >> "$LOG_FILE"

# ── Check if port is already in use ──
PORT_IN_USE=false

if command -v ss &> /dev/null; then
    # Use ss -tln (without -p) to avoid permission issues with Process column
    if port_in_use; then
        PORT_IN_USE=true
    fi
elif command -v lsof &> /dev/null; then
    if lsof -i :$PORT -sTCP:LISTEN 2>/dev/null | grep -q .; then
        PORT_IN_USE=true
    fi
elif command -v curl &> /dev/null; then
    if curl -s "http://localhost:$PORT" > /dev/null 2>&1; then
        PORT_IN_USE=true
    fi
fi

if [ "$PORT_IN_USE" = true ]; then
    echo "[$(date)] Port $PORT already in use — opening browser to existing instance" >> "$LOG_FILE"

    # Find the PID — try PID file first, then system methods
    STREAMLIT_PID=$(get_pid_from_file 2>/dev/null)
    if [ -z "$STREAMLIT_PID" ]; then
        STREAMLIT_PID=$(get_pid_from_system 2>/dev/null)
    fi

    if [ -n "$STREAMLIT_PID" ]; then
        echo "Press Ctrl+C to stop Streamlit (PID: $STREAMLIT_PID)" >&2
        trap cleanup SIGINT SIGTERM

        # Open browser
        xdg-open "http://localhost:$PORT" 2>/dev/null &
        disown
        notify-send "PDF Tool Pro" "App is running!\nhttp://localhost:$PORT" -i dialog-information 2>/dev/null || true

        # Poll instead of wait — wait only works on child processes,
        # but Streamlit was started by a previous ./run invocation
        while kill -0 "$STREAMLIT_PID" 2>/dev/null; do
            sleep 1
        done

        # Streamlit exited on its own (crash)
        rm -f "$PID_FILE"
        echo "Streamlit has exited." >&2
        exit 1
    else
        echo "⚠️  Could not find Streamlit PID — using fuser fallback" >&2
        echo "Press Ctrl+C to stop Streamlit and exit" >&2
        # Still open the browser so the user can use the app
        xdg-open "http://localhost:$PORT" 2>/dev/null &
        disown
        notify-send "PDF Tool Pro" "App is running!\nhttp://localhost:$PORT" -i dialog-information 2>/dev/null || true
        # Use fuser -k to kill process by port (no PID needed!)
        cleanup_unknown() {
            echo ""
            echo "Stopping Streamlit on port $PORT..."
            if kill_by_port; then
                echo "✅ Streamlit stopped."
            else
                echo "⚠️  Could not stop Streamlit. It may still be running."
            fi
            rm -f "$PID_FILE"
            exit 0
        }
        trap cleanup_unknown SIGINT SIGTERM
        while port_in_use; do
            sleep 1
        done
        echo "Streamlit is no longer running." >&2
        exit 1
    fi
fi

# ── Launch Streamlit in background ──
"$PYTHON" -m streamlit run "$SCRIPT_DIR/pdf_ui.py" \
    --server.port "$PORT" \
    --server.headless true --browser.gatherUsageStats false \
    >> "$LOG_FILE" 2>&1 &
STREAMLIT_PID=$!
echo "$STREAMLIT_PID" > "$PID_FILE"
echo "[$(date)] Streamlit PID: $STREAMLIT_PID" >> "$LOG_FILE"

# ── Trap Ctrl+C to kill Streamlit (reuse shared cleanup) ──
trap cleanup SIGINT SIGTERM

# ── Poll port until Streamlit is ready (up to 30s) ──
echo "[$(date)] Waiting for Streamlit on port $PORT..." >> "$LOG_FILE"
READY=false
for i in $(seq 1 30); do
    if port_in_use; then
        READY=true
        break
    elif command -v lsof &> /dev/null; then
        if lsof -i :$PORT -sTCP:LISTEN 2>/dev/null | grep -q .; then
            READY=true
            break
        fi
    elif command -v curl &> /dev/null; then
        if curl -s "http://localhost:$PORT" > /dev/null 2>&1; then
            READY=true
            break
        fi
    fi
    sleep 1
done

if [ "$READY" = false ]; then
    echo "[$(date)] Streamlit did not start within 30s" >> "$LOG_FILE"
    rm -f "$PID_FILE"
    show_error "PDF Tool Pro" "Streamlit failed to start.\n\nCheck the log:\n$LOG_FILE"
    exit 1
fi

echo "[$(date)] Streamlit ready after ${i}s" >> "$LOG_FILE"

# ── Open browser ──
echo "[$(date)] Opening browser..." >> "$LOG_FILE"
xdg-open "http://localhost:$PORT" 2>/dev/null &
disown

# ── Show notification ──
notify-send "PDF Tool Pro" "App is running!\nhttp://localhost:$PORT" -i dialog-information 2>/dev/null || true

echo "[$(date)] Launcher complete" >> "$LOG_FILE"
echo "Press Ctrl+C to stop Streamlit"

# ── Wait for Streamlit to keep trap active ──
wait "$STREAMLIT_PID" 2>/dev/null
rm -f "$PID_FILE"
echo "Streamlit has exited."
exit 1
